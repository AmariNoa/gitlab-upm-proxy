# Defaults for the test run, supplied through DOTENV_CONFIG_PATH.
#
# These three are the variables the code requires at module load, so a test file that does
# not set them itself still gets a value. Every value here is a placeholder; nothing in this
# file names a real host or a real path, which is why it can be version controlled.
PUBLIC_BASE_URL=https://upm.example.com
UPSTREAM_CONFIG_PATH=test/fixtures/upstreams.test.yml
TARBALL_CACHE_DIR=.test-cache
