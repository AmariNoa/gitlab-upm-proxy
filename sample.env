PUBLIC_BASE_URL=https://upm.sample.domain
TARBALL_CACHE_DIR=./data/cache
UPSTREAM_CONFIG_PATH=config/upstreams.yml
NPM_SIGNATURE_KEY_PATH=./data/cache/npm-signing-key.pem
VPM_PREFETCH_INTERVAL_SEC=2
# Optional limits on one upstream archive. Defaults apply when unset.
# VPM_MAX_DOWNLOAD_BYTES=536870912
# VPM_MAX_EXTRACT_BYTES=1073741824
# VPM_MAX_EXTRACT_ENTRIES=20000
